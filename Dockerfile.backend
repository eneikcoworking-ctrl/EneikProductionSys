ARG ENEIK_BUILD_GIT_SHA=unknown
ARG ENEIK_BUILD_GIT_DIRTY=unknown
ARG ENEIK_BUILD_TIME=unknown

FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
COPY docs ./docs
COPY BARCAN-*.md ./
COPY src ./src
RUN mvn -q package -DskipTests

FROM eclipse-temurin:17-jre
ARG ENEIK_BUILD_GIT_SHA
ARG ENEIK_BUILD_GIT_DIRTY
ARG ENEIK_BUILD_TIME
WORKDIR /app
# Only git (2026-08-28, §5c-J of the action plan). This line used to install ripgrep, docker.io,
# docker-compose-v2, nodejs, npm, python3 and python3-pip as well: 823 MB of the image's 1.59 GB, none of
# it reachable. Measured rather than assumed - a JVM can start a process only through ProcessBuilder or
# Runtime.exec, there are zero of the latter and three sites of the former, and all three run `git`
# (AutoMergeService:2753, FalsificationCycleService:1658, and SystemDriftController, whose helper hard-codes
# "git" as argv[0]). No command is assembled from settings or the database, so the list is exhaustive.
#
# The Docker CLI was the worst of them: the socket is deliberately NOT mounted into this container, so it
# could never have reached a daemon - and shipping it contradicts the containment decision written in
# docker-compose.yml, that runtime-launcher alone holds that privilege. Client code is built and tested on
# Jules and inside the client's own stack, never in this image; the factory only writes files into the
# workspaces (ProjectWorkspaceFactoryService, TechnicalLeadCompiler start no process at all).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/target/*.jar app.jar
COPY docs ./docs
COPY BARCAN-*.md ./
LABEL org.opencontainers.image.revision=$ENEIK_BUILD_GIT_SHA \
      com.eneik.build.git-dirty=$ENEIK_BUILD_GIT_DIRTY \
      com.eneik.build.time=$ENEIK_BUILD_TIME
ENV ENEIK_BUILD_GIT_SHA=$ENEIK_BUILD_GIT_SHA \
    ENEIK_BUILD_GIT_DIRTY=$ENEIK_BUILD_GIT_DIRTY \
    ENEIK_BUILD_TIME=$ENEIK_BUILD_TIME
# No JAVA_OPTS here (2026-08-28). This line declared -Xmx1536m while docker-compose.yml declared its
# own value, and which one applied could only be learned by experiment: compose replaces the whole
# variable, so this one silently lost - but it still applied to anyone who ran the image without
# that file, against a 1 GB mem_limit it knew nothing about. Two numbers for one quantity is the
# defect; hiding one of them is not a fix. Sizing now comes from the cgroup via
# -XX:MaxRAMPercentage in docker-compose.yml, and an image run without it gets the JVM's own
# container-aware default (25% of the limit) rather than a stale number from 2026.
EXPOSE 8080
# `exec` matters (2026-08-28): without it `sh` stays PID 1 and java runs as its child, so the SIGTERM
# Docker sends on `compose stop` is delivered to sh, which does not forward it. Java never saw a
# shutdown signal, Spring never closed its context, @PreDestroy never ran, H2 was never closed
# cleanly - and every container in this project exited 137 (SIGKILL) after the grace period. That is
# why SHUTDOWN COMPACT had never executed once and the store kept growing. With exec, java IS PID 1
# and receives the signal itself.
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
