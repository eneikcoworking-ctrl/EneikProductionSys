ARG ENEIK_BUILD_GIT_SHA=unknown
ARG ENEIK_BUILD_GIT_DIRTY=unknown
ARG ENEIK_BUILD_TIME=unknown

FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
COPY docs ./docs
COPY BARCAN-*.md ./
COPY src ./src
RUN mvn -q package -DskipTests

FROM eclipse-temurin:17-jre
ARG ENEIK_BUILD_GIT_SHA
ARG ENEIK_BUILD_GIT_DIRTY
ARG ENEIK_BUILD_TIME
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ripgrep docker.io docker-compose-v2 nodejs npm python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/target/*.jar app.jar
COPY docs ./docs
COPY BARCAN-*.md ./
LABEL org.opencontainers.image.revision=$ENEIK_BUILD_GIT_SHA \
      com.eneik.build.git-dirty=$ENEIK_BUILD_GIT_DIRTY \
      com.eneik.build.time=$ENEIK_BUILD_TIME
ENV ENEIK_BUILD_GIT_SHA=$ENEIK_BUILD_GIT_SHA \
    ENEIK_BUILD_GIT_DIRTY=$ENEIK_BUILD_GIT_DIRTY \
    ENEIK_BUILD_TIME=$ENEIK_BUILD_TIME
ENV JAVA_OPTS="-Xms512m -Xmx1536m -XX:+UseG1GC"
EXPOSE 8080
# `exec` matters (2026-08-28): without it `sh` stays PID 1 and java runs as its child, so the SIGTERM
# Docker sends on `compose stop` is delivered to sh, which does not forward it. Java never saw a
# shutdown signal, Spring never closed its context, @PreDestroy never ran, H2 was never closed
# cleanly - and every container in this project exited 137 (SIGKILL) after the grace period. That is
# why SHUTDOWN COMPACT had never executed once and the store kept growing. With exec, java IS PID 1
# and receives the signal itself.
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
